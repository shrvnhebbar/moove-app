{
  "expo": {
    "name": "MOOVE",
    "slug": "form-fitness-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B0D",
    "splash": {
      "backgroundColor": "#0B0B0D"
    },
    "android": {
      "package": "com.yourcompany.form",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0B0D"
      }
    },
    "ios": {
      "bundleIdentifier": "com.yourcompany.form"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow MOOVE to access your photos to set a profile picture.",
          "cameraPermission": "Allow MOOVE to use the camera to take a profile picture."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b362eb3f-f6d6-49aa-aebd-591954a67232"
      }
    }
  }
}
